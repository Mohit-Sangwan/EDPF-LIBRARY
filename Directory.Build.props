<Project>

  <!--
    ═══════════════════════════════════════════════════════════════════════════
    EDPF — Enterprise Data Platform Framework
    Root build configuration. Normative source: Appendix Z (Z.1, Z.3, Z.4, Z.13)
    and Phase 01 of the Execution Playbook.

    Constraining ADRs: ADR-002 (multi-target tiers), ADR-011 (repo topology).
    ═══════════════════════════════════════════════════════════════════════════
  -->

  <PropertyGroup Label="TargetFrameworkTiers">
    <!--
      ADR-002 tiered surface, as amended by ADR-038:
        Tier 1 (net8.0, net10.0)  — full surface.
        Tier 3 (net472, net48)    — reduced surface: data access, config,
                                    logging, security primitives only.
      Divergence is isolated in Edpf.Compatibility; `#if` is forbidden
      everywhere else (Z.3 rule 12, enforced by architecture test EDPF0002).

      Tier 2 (net6.0) was RETIRED by ADR-038. It was out of Microsoft support
      for twenty-one months, every Microsoft.Extensions package it referenced
      declared it unsupported and untested, no test had ever executed on it,
      and the pinned test runner could not target it at all. A support claim
      the repository could not back.
    -->
    <EdpfLibraryTargetFrameworks>net472;net48;net8.0;net10.0</EdpfLibraryTargetFrameworks>
    <EdpfModernTargetFrameworks>net8.0;net10.0</EdpfModernTargetFrameworks>
    <!--
      Tier 1 only, since ADR-038. Used by assemblies outside the Tier 3 surface
      that ADR-002 defines — data-platform services (classification, lineage,
      MDM, CDC) are not part of the "data access, config, logging, security
      primitives" that net472/net48 receive. Declaring that here keeps the
      exclusion a stated architectural decision rather than an accident of
      whichever API happened to be unavailable.

      This currently holds the same value as EdpfModernTargetFrameworks and is
      deliberately kept separate: the two encode different decisions that merely
      coincide today. "Deliberately outside Tier 3" and "a modern-only tool" are
      not the same statement, and they will diverge again the next time a tier
      moves.
    -->
    <EdpfPlatformTargetFrameworks>net8.0;net10.0</EdpfPlatformTargetFrameworks>
    <!--
      ARMED, per ADR-038. This was previously false, which is how net6.0 stayed
      in the matrix for twenty-one months after going out of support: NETSDK1138
      carries a warning code, so with TreatWarningsAsErrors it FAILS the build —
      and suppressing it was the only thing keeping "warnings as errors" and "we
      ship an EOL runtime" true at the same time.

      Leaving it armed means the next framework to reach end of support cannot be
      absorbed silently. It will stop the build, and that is the intended
      behaviour: a deliberate decision to drop or knowingly retain a tier, made
      on the day it goes EOL rather than discovered nearly two years later.
    -->
    <CheckEolTargetFramework>true</CheckEolTargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Compiler">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Z.3 rule 1: style and analysis failures are build failures, not suggestions. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      Z.4 EDPF0013: any public API change requires an explicit
      PublicAPI.Unshipped.txt edit — accidental breaking changes cannot merge
      silently. The baseline lives beside each tracked project.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Label="Determinism">
    <!-- Z.13: every build is reproducible and deterministic. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <!-- Z.14: every package in a release shares the version. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <Authors>EDPF Contributors</Authors>
    <Company>EDPF</Company>
    <Product>Enterprise Data Platform Framework</Product>
    <Copyright>© EDPF Contributors</Copyright>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable> <!-- opted in per shippable project -->
  </PropertyGroup>

  <!-- The licence file travels with every package (ADR-009). -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

  <PropertyGroup Label="Conventions">
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!-- .NET Framework reference assemblies: allows Tier 3 targets to build on
       any machine/agent without a locally installed targeting pack. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

</Project>
