<?xml version="1.0" encoding="utf-8"?>
<!--
  Single authoritative feed. Deterministic restore requires that every machine
  and every CI agent resolve packages from the same source (Appendix Z.13).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
