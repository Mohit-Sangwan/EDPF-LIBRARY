<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    The second host (ADR-037 v1.0 addition 4). NON-SHIPPABLE, like the walking
    skeleton: it exists to demonstrate that the framework's guarantees are not
    properties of ASP.NET Core.

    net10.0 only. The walking skeleton multi-targets to prove the framework
    builds on both Tier 1 TFMs; repeating that here would double the build for
    no additional evidence.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UserSecretsId>edpf-worker-host</UserSecretsId>
    <RootNamespace>Edpf.WorkerHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Edpf.Abstractions\Edpf.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\src\Edpf.Core\Edpf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
