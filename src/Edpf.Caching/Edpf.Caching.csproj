<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 15 — Caching. In-memory L1 with stampede protection; Redis L2 and
    coherent pub/sub invalidation arrive as an optional package so the core
    graph carries no Redis client (ADR-009).
  -->
  <PropertyGroup>
    <TargetFrameworks>$(EdpfLibraryTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>Enterprise Data Platform Framework — tenant-safe caching with stampede protection.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edpf.Abstractions\Edpf.Abstractions.csproj" />
    <ProjectReference Include="..\Edpf.Core\Edpf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
