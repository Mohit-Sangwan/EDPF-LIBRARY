<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 23 — Data Platform Services.
    The phases that earn the name "data platform" rather than "data access
    layer": classification, lineage, entity resolution and synthetic data.
  -->
  <PropertyGroup>
    <!--
      Tier 1 + Tier 2 (ADR-002). Data-platform services are deliberately
      outside the Tier 3 reduced surface, which covers data access, config,
      logging and security primitives only. A net48 host consumes the platform
      through its API rather than in-process.
    -->
    <TargetFrameworks>$(EdpfPlatformTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>Enterprise Data Platform Framework — automated classification, lineage, entity resolution and synthetic data.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edpf.Abstractions\Edpf.Abstractions.csproj" />
    <ProjectReference Include="..\Edpf.Core\Edpf.Core.csproj" />
  </ItemGroup>

</Project>
