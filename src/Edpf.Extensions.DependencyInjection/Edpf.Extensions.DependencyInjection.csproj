<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 04 — Dependency Injection & Composition (ADR-014).
    Feature-module registration, explicit lifetime policy, and mandatory
    captive-dependency detection. This project does NOT replace
    Microsoft.Extensions.DependencyInjection — Phase 04 §③ is explicit that
    EDPF uses a container, it does not write one.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(EdpfLibraryTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>Enterprise Data Platform Framework — composition root: feature-module registration, lifetime policy and captive-dependency detection.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Edpf.Abstractions\Edpf.Abstractions.csproj" />
    <ProjectReference Include="..\Edpf.Core\Edpf.Core.csproj" />
    <ProjectReference Include="..\Edpf.Configuration\Edpf.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
