<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!--
    Test code: correctness bar identical (warnings as errors stays on), but
    library-consumer rules do not apply — tests are not public API and are not
    shipped (Z.7/Z.8 govern test content; Z.3 governs library code).
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CS1591;CA2007;CA1707</NoWarn> <!-- no XML docs, no ConfigureAwait, underscore test names -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The benchmark executable is not an xunit host (Z.9); it opts out. -->
  <ItemGroup Condition="'$(EdpfIsBenchmarkProject)' != 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
