<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 33 — the `edpf` CLI. Packaged as a dotnet tool so consumers install
    it with `dotnet tool install -g Edpf.Cli` and invoke `dotnet edpf`.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>edpf</ToolCommandName>
    <RootNamespace>Edpf.Cli</RootNamespace>
    <AssemblyName>Edpf.Cli</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CS1591;CA2007</NoWarn>
    <Description>Enterprise Data Platform Framework — command-line tooling.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Edpf.Abstractions\Edpf.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Edpf.Core\Edpf.Core.csproj" />
    <ProjectReference Include="..\..\src\Edpf.DataPlatform\Edpf.DataPlatform.csproj" />
    <ProjectReference Include="..\..\src\Edpf.Operations\Edpf.Operations.csproj" />
  </ItemGroup>

</Project>
